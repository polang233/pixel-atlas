{
  "name": "pixel-atlas",
  "private": true,
  "version": "0.0.0",
  "description": "Millions of pixel-art resources, in one place.",
  "license": "MPL-2.0",
  "homepage": "https://pixelatlas.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/polang233/pixel-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/polang233/pixel-atlas/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "VITE_ATLAS_BASE=${VITE_ATLAS_BASE:-https://cdn.pixelatlas.org/atlas/v1} npm run build && rm -rf dist/atlas && wrangler deploy --config deploy/wrangler.jsonc",
    "typecheck": "tsc",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "ci": "biome ci . && npm run check:i18n && npm run build",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "gsap": "^3.15.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "linkedom": "0.18.14",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "4.160.0"
  }
}
