# Base URL of the streaming atlas (the output of pipeline/build_atlas.py).
#
# Leave it unset to use the local copy that Vite serves from public/atlas.
# Set it to load the atlas from another origin, for example the R2 bucket:
#
#   VITE_ATLAS_BASE=https://cdn.pixelatlas.org/atlas/v1
#
# Vite inlines the value at build time, so set it where the build runs: in
# .env.local for local work (git ignores it), or as a build environment variable
# on Cloudflare Pages. An atlas on another origin must send CORS headers for the
# site's origin; see deploy/r2-cors.json.
VITE_ATLAS_BASE=
